# Nonsecret build tags only. Pass this file explicitly so Docker Compose never
# reads an owner credential file as project interpolation input.
AQT_TRUSTED_TIME_SOURCE_IMAGE=autoquanttrader-trusted-time-source:phase6d-v1
AQT_TRUSTED_TIME_SUPERVISOR_IMAGE=autoquanttrader-trusted-time-supervisor:phase6d-v1
# Nonsecret parse/build placeholder only. The launcher replaces this with one
# fresh owner-only file and refuses to start a topology against this device.
AQT_TRUSTED_TIME_DATABASE_SECRET_SOURCE_FILE=/dev/null
# Phase 6D parse-only placeholders. The production launcher must replace all
# three with exact reviewed/owner-only files before starting the supervisor.
AQT_TRUSTED_TIME_HEAD_ANCHOR_AUTHORITY_SOURCE_FILE=/dev/null
AQT_TRUSTED_TIME_HEAD_ANCHOR_AUTH_SECRET_SOURCE_FILE=/dev/null
AQT_TRUSTED_TIME_HEAD_ANCHOR_SIGNING_KEY_SECRET_SOURCE_FILE=/dev/null
