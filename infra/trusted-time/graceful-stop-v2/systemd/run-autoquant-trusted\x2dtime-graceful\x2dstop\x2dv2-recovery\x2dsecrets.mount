[Unit]
Description=AutoQuant trusted-time graceful-stop v2 recovery-secret tmpfs candidate
Before=autoquant-trusted-time-graceful-stop-v2-recovery-provision.service autoquant-trusted-time-graceful-stop-v2-recovery.service
After=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-transport.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-host\x2dsecrets.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-supervisor\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-host-provision.service autoquant-trusted-time-graceful-stop-v2-supervisor-provision.service autoquant-trusted-time-graceful-stop-v2-host.service autoquant-trusted-time-graceful-stop-v2-supervisor.service
Conflicts=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-transport.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-host\x2dsecrets.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-supervisor\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-host-provision.service autoquant-trusted-time-graceful-stop-v2-supervisor-provision.service autoquant-trusted-time-graceful-stop-v2-host.service autoquant-trusted-time-graceful-stop-v2-supervisor.service

[Mount]
What=tmpfs
Where=/run/autoquant/trusted-time/graceful-stop-v2/recovery-secrets
Type=tmpfs
Options=nodev,nosuid,noexec,size=64K,mode=0700,uid=0,gid=0
