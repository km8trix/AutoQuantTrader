[Unit]
Description=AutoQuant trusted-time graceful-stop v2 host-secret tmpfs candidate
Before=autoquant-trusted-time-graceful-stop-v2-host-provision.service autoquant-trusted-time-graceful-stop-v2-host.service
Conflicts=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-recovery\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-recovery-provision.service autoquant-trusted-time-graceful-stop-v2-recovery.service

[Mount]
What=tmpfs
Where=/run/autoquant/trusted-time/graceful-stop-v2/host-secrets
Type=tmpfs
Options=nodev,nosuid,noexec,size=64K,mode=0700,uid=0,gid=0
