[Unit]
Description=AutoQuant trusted-time graceful-stop v2 host credential provisioner candidate
Requires=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-host\x2dsecrets.mount
After=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-host\x2dsecrets.mount
Before=autoquant-trusted-time-graceful-stop-v2-host.service
Conflicts=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-recovery\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-recovery-provision.service autoquant-trusted-time-graceful-stop-v2-recovery.service
ConditionPathIsMountPoint=!/run/autoquant/trusted-time/graceful-stop-v2/recovery-secrets

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/autoquant/trusted-time-graceful-stop-v2-provision/bin/autoquant-trusted-time-graceful-stop-v2-host-provision
StandardInput=null
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/autoquant/trusted-time/graceful-stop-v2/host-secrets
