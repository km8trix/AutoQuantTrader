[Unit]
Description=AutoQuant trusted-time graceful-stop v2 supervisor-secret tmpfs candidate
Documentation=docs/adr/0121-trusted-time-graceful-stop-lifecycle-v2-implementation-resolution.md
Before=autoquant-trusted-time-graceful-stop-v2-supervisor-provision.service autoquant-trusted-time-graceful-stop-v2-supervisor.service
Conflicts=autoquant-trusted-time-graceful-stop-v2-recovery.service

[Mount]
What=tmpfs
Where=/run/autoquant/trusted-time/graceful-stop-v2/supervisor-secrets
Type=tmpfs
Options=nodev,nosuid,noexec,size=64K,mode=0730,uid=0,gid=10001
