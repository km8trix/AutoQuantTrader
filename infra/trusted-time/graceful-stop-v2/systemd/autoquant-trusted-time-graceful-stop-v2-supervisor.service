[Unit]
Description=AutoQuant trusted-time graceful-stop v2 supervisor endpoint candidate
Requires=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-transport.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-supervisor\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-supervisor-provision.service
After=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-transport.mount run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-supervisor\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-supervisor-provision.service
Conflicts=autoquant-trusted-time-graceful-stop-v2-recovery.service autoquant-trusted-time-graceful-stop-v2-recovery-provision.service run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-recovery\x2dsecrets.mount
ConditionPathIsMountPoint=!/run/autoquant/trusted-time/graceful-stop-v2/recovery-secrets

[Service]
Type=simple
User=10001
Group=10001
SupplementaryGroups=10001
UMask=0177
ExecStart=/opt/autoquant/trusted-time-graceful-stop-v2-supervisor/bin/autoquant-trusted-time-graceful-stop-v2-supervisor
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/autoquant/trusted-time/graceful-stop-v2/transport /run/autoquant/trusted-time/graceful-stop-v2/supervisor-secrets
