[Unit]
Description=AutoQuant trusted-time graceful-stop v2 transport tmpfs candidate
Before=autoquant-trusted-time-graceful-stop-v2-host.service autoquant-trusted-time-graceful-stop-v2-supervisor.service
Conflicts=run-autoquant-trusted\x2dtime-graceful\x2dstop\x2dv2-recovery\x2dsecrets.mount autoquant-trusted-time-graceful-stop-v2-recovery-provision.service autoquant-trusted-time-graceful-stop-v2-recovery.service

[Mount]
What=tmpfs
Where=/run/autoquant/trusted-time/graceful-stop-v2/transport
Type=tmpfs
Options=nodev,nosuid,noexec,size=64K,mode=0770,uid=0,gid=10001
