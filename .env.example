# Local development only. Live and paper credentials belong in a secret manager.
AQT_ENVIRONMENT=local
AQT_LOG_LEVEL=INFO
AQT_LOCAL_AUTH_ENABLED=true
AQT_CORS_ORIGINS=http://localhost:5173
AQT_API_HOST=127.0.0.1
AQT_API_PORT=8000

# Host ports. Container-to-container ports are fixed inside Compose.
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432

# Local PostgreSQL. Change the password before exposing the database beyond localhost.
POSTGRES_USER=autoquant
POSTGRES_PASSWORD=autoquant_local_only
POSTGRES_DB=autoquant
AQT_DATABASE_URL=postgresql+psycopg://autoquant:autoquant_local_only@localhost:5432/autoquant

# Phase 1A local, content-addressed data lake and synthetic admission fixture.
AQT_DATA_LAKE_PATH=.local/data-lake
AQT_MARKET_DATA_FIXTURE_PATH=tests/fixtures/market_data/phase1_bars.jsonl

# Optional local-only Phase 1 vendor-access probes and bounded research captures.
# These are not passed into Compose services, do not select a provider, and never
# establish admission or trading authority.
# Non-local deployments must replace .env credentials with scoped secret refs.
# After copying this file, restrict it with: chmod 600 .env
TIINGO_TOKEN=
NASDAQ_DATA_LINK_API_KEY=
MASSIVE_API_KEY=
MASSIVE_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com

# Broker credentials remain dormant during Phase 1. E*TRADE defaults to sandbox;
# Alpaca paper is the first broker candidate in a later phase.
ETRADE_ENV=sandbox
ETRADE_SANDBOX_CONSUMER_KEY=
ETRADE_SANDBOX_CONSUMER_SECRET=
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_SECRET=
ETRADE_ACCOUNT_ID_KEY=
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Used when running Vite directly on the host. Compose overrides this to the API service.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_USE_DEV_FIXTURES=false

# OIDC is intentionally disabled in the local environment. Do not put live secrets here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AQT_SESSION_SECRET=local-development-only-change-before-deployment
