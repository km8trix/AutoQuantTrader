# Local development and the supervised paper preflight only. Never place live
# credentials here. Keep paper secrets in the untracked mode-0600 .env or a
# stronger local secret store.
AQT_ENVIRONMENT=local
AQT_LOG_LEVEL=INFO
AQT_LOCAL_AUTH_ENABLED=true
AQT_CORS_ORIGINS=http://localhost:5173
AQT_API_HOST=127.0.0.1
AQT_API_PORT=8000

# Host ports. Container-to-container ports are fixed inside Compose.
API_PORT=8000
WEB_PORT=5173
POSTGRES_PORT=5432

# Local PostgreSQL. Change the password before exposing the database beyond localhost.
# For ADR 0088's owner-supervised smoke, replace this value only in the
# untracked mode-0600 .env with the Supabase Free runtime DSN. Never commit or
# print that DSN, and never point AQT_DATABASE_URL at the destructive test DB.
# Its sole query option must be sslmode=verify-full. Runtime code then supplies
# the packaged, hash-pinned Supabase 2021 root CA explicitly; do
# not add sslrootcert to the DSN or rely on a user/system default trust path.
# The credential-aware local preflight validates this value, database
# separation, TLS, and the exact migrated schema. Presence alone is not
# readiness evidence, and the default image command remains an unbound check.
POSTGRES_USER=autoquant
POSTGRES_PASSWORD=autoquant_local_only
POSTGRES_DB=autoquant
AQT_DATABASE_URL=postgresql+psycopg://autoquant:autoquant_local_only@localhost:5432/autoquant

# Phase 6D launcher inputs are absolute paths only. Keep each referenced file
# owner-only (mode 0600 or stricter), outside version control, and do not place
# the authority JSON, Auth secret, or raw 32-byte signing key in this dotenv.
AQT_TRUSTED_TIME_HEAD_ANCHOR_AUTHORITY_SOURCE_FILE=/absolute/path/head-anchor-authority.json
AQT_TRUSTED_TIME_HEAD_ANCHOR_AUTH_SECRET_SOURCE_FILE=/absolute/path/head-anchor-auth.json
AQT_TRUSTED_TIME_HEAD_ANCHOR_SIGNING_KEY_SECRET_SOURCE_FILE=/absolute/path/head-anchor-signing-key.bin

# Phase 1A local, content-addressed data lake and synthetic admission fixture.
AQT_DATA_LAKE_PATH=.local/data-lake
AQT_MARKET_DATA_FIXTURE_PATH=tests/fixtures/market_data/phase1_bars.jsonl

# Optional local-only Phase 1 vendor-access probes and bounded research captures.
# These are not passed into Compose services, do not select a provider, and never
# establish admission or trading authority.
# Non-local deployments must replace .env credentials with scoped secret refs.
# After copying this file, restrict it with: chmod 600 .env
TIINGO_TOKEN=
NASDAQ_DATA_LINK_API_KEY=
MASSIVE_API_KEY=
MASSIVE_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com

# Broker credentials remain dormant. E*TRADE defaults to sandbox. Phase 4G's
# Alpaca account-observation boundary accepts only these nonsecret local alias,
# provider UUID pin, secret-manager reference, and immutable secret version
# values. Phase 4H's asset observation and Phase 4I's authenticated client-order
# lookup reuse that account reference and require a separately supplied,
# nonsecret candidate-asset UUID pin at their uncomposed runtime boundaries.
# None of these slices reads direct credential values or enables startup.
ETRADE_ENV=sandbox
ETRADE_SANDBOX_CONSUMER_KEY=
ETRADE_SANDBOX_CONSUMER_SECRET=
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_SECRET=
ETRADE_ACCOUNT_ID_KEY=
AQT_PAPER_ACCOUNT_ID=
AQT_PAPER_PROVIDER_ACCOUNT_ID=
AQT_PAPER_BROKER_SECRET_REF=
AQT_PAPER_BROKER_SECRET_VERSION=
AQT_PAPER_DATA_SECRET_REF=

# ADR 0088's nonsecret paper-smoke identity. The trader entrypoint verifies the
# checked-in no-exposure artifact and reports every unbound external source; it
# does not resolve the references above or start a trading loop.
AQT_PAPER_DEPLOYMENT_ID=aqt-paper-smoke
AQT_PAPER_DEPLOYMENT_REVISION=unbound-preflight

# Sentry OTLP tracing is the diagnostic-only backend for the supervised local
# smoke. Put its DSN only in the untracked mode-0600 .env. Never commit it.
# Transport acceptance does not prove queryable ingestion or alert delivery.
# The credential-aware local preflight validates the DSN shape without
# relabeling Sentry as an alert provider.
AQT_SENTRY_DSN=

# PagerDuty, Twilio, and an external heartbeat watchdog are deferred. This
# profile does not read or bind their credentials, routes, senders, or
# recipients even if an owner-only environment contains them. External
# notification evidence remains UNAVAILABLE, so the smoke must stay directly
# supervised, no-exposure-only, and fail closed.

# Destructive PostgreSQL tests only. Never reuse this database as
# AQT_DATABASE_URL for the supervised paper smoke.
AQT_TEST_POSTGRES_URL=

# Used when running Vite directly on the host. Compose overrides this to the API service.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_USE_DEV_FIXTURES=false

# OIDC is intentionally disabled in the local environment. Do not put live secrets here.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AQT_SESSION_SECRET=local-development-only-change-before-deployment
