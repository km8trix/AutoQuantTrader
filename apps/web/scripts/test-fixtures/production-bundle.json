{
  "policy": {
    "contract_version": "phase6b-production-bundle-admission-v1",
    "entry_module": "index.html",
    "route_modules": [
      "src/routes/Route01.tsx",
      "src/routes/Route02.tsx",
      "src/routes/Route03.tsx",
      "src/routes/Route04.tsx",
      "src/routes/Route05.tsx",
      "src/routes/Route06.tsx",
      "src/routes/Route07.tsx",
      "src/routes/Route08.tsx",
      "src/routes/Route09.tsx",
      "src/routes/Route10.tsx",
      "src/routes/Route11.tsx"
    ],
    "required_shared_partitions": [
      "react-runtime",
      "mui-runtime",
      "query-runtime",
      "vendor-runtime"
    ],
    "max_asset_bytes": 50,
    "max_initial_graph_bytes": 150
  },
  "manifest": {
    "_react.js": {
      "file": "assets/react.js",
      "name": "react-runtime"
    },
    "_mui.js": {
      "file": "assets/mui.js",
      "name": "mui-runtime",
      "imports": [
        "_react.js",
        "_vendor.js"
      ]
    },
    "_query.js": {
      "file": "assets/query.js",
      "name": "query-runtime",
      "imports": [
        "_react.js"
      ]
    },
    "_vendor.js": {
      "file": "assets/vendor.js",
      "name": "vendor-runtime",
      "imports": [
        "_react.js"
      ]
    },
    "index.html": {
      "file": "assets/entry.js",
      "src": "index.html",
      "name": "index",
      "isEntry": true,
      "imports": [
        "_react.js",
        "_mui.js",
        "_query.js",
        "_vendor.js"
      ],
      "dynamicImports": [
        "src/routes/Route01.tsx",
